{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rent-ruby",
  "main": "workers/tenant-demo.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
