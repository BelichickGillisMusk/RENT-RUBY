# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Hosting platforms such as Cloud Run inject this automatically.
PORT=3000

# DATABASE_PATH: Optional SQLite path. Use a mounted volume path in production.
DATABASE_PATH="rentroll_v3.db"

# GOOGLE_CHAT_WEBHOOK: Optional. Wizard of Mosswood chat + waitlist alerts post here.
GOOGLE_CHAT_WEBHOOK=""

# WIZARD_ALERT_EMAIL: Where Wizard/waitlist lead alerts are emailed (requires RESEND_API_KEY).
WIZARD_ALERT_EMAIL="admin@mobilecarbsmoketest.com"

# RESEND_API_KEY: Optional. Enables email alerts via resend.com API (no SMTP needed).
RESEND_API_KEY=""
